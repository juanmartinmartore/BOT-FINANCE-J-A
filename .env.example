# ─── Variables de entorno requeridas ─────────────────────────────────────────
# Copiá este archivo como .env para desarrollo local, o configuralos en
# GitHub Settings > Secrets and variables > Actions para produccion.
#
# NUNCA subas el archivo .env al repositorio. Ya esta en el .gitignore.

# Token del bot de Discord (obtenelo en https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=tu_token_aqui

# ID del canal de Discord donde el bot va a publicar los reportes
# (Click derecho sobre el canal en Discord > Copiar ID)
DISCORD_CHANNEL_ID=tu_channel_id_aqui
